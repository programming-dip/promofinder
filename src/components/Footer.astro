---
const currentYear = new Date().getFullYear();
---

<footer class="bg-base-100 border-t border-base-300 mt-20">
  <div class="max-w-4xl mx-auto px-4 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Brand Info -->
      <div class="text-center md:text-left">
        <a class="text-lg font-black tracking-tight" href="/">

          PromoFinder<span class="text-warning">.com.au</span>
        </a>
        <p class="text-xs text-base-content/60 mt-1">
          Verified promo codes and discount vouchers for Australian shoppers.
        </p>
      </div>

      <!-- Quick Links -->
      <nav
        class="flex flex-wrap justify-center gap-6 text-xs font-semibold text-base-content/70"
      >
        <a href="/" class="hover:text-primary transition">All Deals</a>
        <a href="/privacy-policy/" class="hover:text-primary transition"
          >Privacy Policy</a
        >
        <a href="/terms/" class="hover:text-primary transition"
          >Terms of Service</a
        >
        <a href="/contact/" class="hover:text-primary transition">Contact</a>
      </nav>
    </div>

    <div class="divider my-6"></div>

    <!-- Disclosure & Copyright -->
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-base-content/50"
    >
      <p class="text-center md:text-left max-w-xl">
        <strong>Affiliate Disclaimer:</strong> PromoFinder is an independent deal-discovery
        site. When you click links or use promo codes listed here, we may earn an
        affiliate commission at no extra cost to you.
      </p>
      <p class="whitespace-nowrap">
        &copy; {currentYear} PromoFinder. All rights reserved.
      </p>
    </div>
  </div>
</footer>
