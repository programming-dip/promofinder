---
import deals from '../data/deals.json';
---

<header class="navbar bg-base-100 border-b border-base-300 px-4 md:px-12 sticky top-0 z-50">
  <div class="navbar-start">
    <a class="text-xl font-black tracking-tight" href="/">
      PromoFinder<span class="text-warning">.com.au</span>
    </a>
  </div>

  <!-- Search Bar on the Right Hand Side -->
  <div class="navbar-end relative">
    <div class="relative w-full max-w-xs">
      <label class="input input-sm md:input-md input-bordered flex items-center gap-2 rounded-lg">
        <input 
          type="text" 
          id="global-deal-search" 
          class="grow text-xs md:text-sm" 
          placeholder="Search brands, deals..." 
          autocomplete="off"
        />
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 opacity-70 shrink-0">
          <path fill-rule="evenodd" d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" clip-rule="evenodd" />
        </svg>
      </label>

      <!-- Live Search Results Dropdown -->
      <div 
        id="search-results-box" 
        class="hidden absolute right-0 mt-2 w-72 md:w-80 bg-base-100 rounded-xl shadow-xl border border-base-300 max-h-96 overflow-y-auto z-50 p-2"
      >
        <div id="search-results-list" class="flex flex-col gap-1"></div>
      </div>
    </div>
  </div>
</header>

<!-- Pass JSON Data directly to Client-Side Script -->
<script define:vars={{ deals }}>
  const searchInput = document.getElementById('global-deal-search');
  const resultsBox = document.getElementById('search-results-box');
  const resultsList = document.getElementById('search-results-list');

  if (searchInput && resultsBox && resultsList) {
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim().toLowerCase();

      if (!query) {
        resultsBox.classList.add('hidden');
        resultsList.innerHTML = '';
        return;
      }

      // Filter by Brand, Title, or Description
      const matches = deals.filter((deal) => 
        deal.brand.toLowerCase().includes(query) ||
        deal.title.toLowerCase().includes(query) ||
        deal.description.toLowerCase().includes(query)
      );

      if (matches.length === 0) {
        resultsList.innerHTML = `
          <div class="p-3 text-xs text-base-content/60 text-center">
            No active coupons found for "${query}"
          </div>
        `;
      } else {
        resultsList.innerHTML = matches.map(deal => `
          <a 
            href="/deals/${deal.slug}/" 
            class="flex items-center gap-3 p-2 rounded-lg hover:bg-base-200 transition text-left"
          >
            <img src="${deal.image}" alt="${deal.brand}" class="w-9 h-9 object-contain rounded border border-base-200 p-1 shrink-0" />
            <div class="overflow-hidden">
              <p class="text-xs font-bold text-base-content truncate">${deal.brand}</p>
              <p class="text-[11px] text-base-content/70 truncate">${deal.title}</p>
              <span class="badge badge-warning badge-xs font-bold mt-0.5">${deal.discount}</span>
            </div>
          </a>
        `).join('');
      }

      resultsBox.classList.remove('hidden');
    });

    // Hide dropdown on outside click
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !resultsBox.contains(e.target)) {
        resultsBox.classList.add('hidden');
      }
    });
  }
</script>