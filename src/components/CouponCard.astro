---
const { deal } = Astro.props;
const detailPageUrl = `/deals/${deal.slug}/`;
const currentDate = new Intl.DateTimeFormat("en-AU", {
  month: "long",
  year: "numeric",
}).format(new Date());
---

<div
  class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition mb-6 overflow-hidden"
>
  <div class="card-body p-6">
    <div class="flex flex-col md:flex-row items-center gap-6">
      <!-- Product Image -->
      <a
        href={detailPageUrl}
        class="shrink-0 flex flex-col items-center justify-center border border-base-200 rounded-lg p-3 w-32 hover:opacity-80 transition"
      >
        <img
          src={deal.image}
          alt={deal.title}
          class="w-24 h-24 object-contain"
          loading="lazy"
        />
        <span
          class="badge badge-outline text-xs uppercase font-semibold mt-2 h-auto whitespace-nowrap"
        >
          {deal.type === "code" ? "COUPON CODE" : "DIRECT DEAL"}
        </span>
      </a>

      <!-- Deal Copy -->
      <div class="flex-1 text-left">
        <div class="flex items-center gap-2 text-xs text-base-content/60 mb-1">
          <svg
            class="w-3.5 h-3.5 text-success"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          <span>Verified & Active {currentDate}</span>
        </div>

        <h2
          class="text-base md:text-lg font-bold text-base-content leading-snug"
        >
          <a href={detailPageUrl} class="hover:text-primary transition">
            <span class="text-error">🔥</span>
            {deal.title}
          </a>
        </h2>

        <div class="flex flex-wrap items-baseline gap-2 mt-2">
          <span class="text-xl font-black text-error">${deal.price}</span>
          {
            deal.originalPrice && (
              <span class="text-sm text-base-content/40 line-through">
                ${deal.originalPrice}
              </span>
            )
          }
          <span class="badge badge-error badge-sm font-bold text-white"
            >{deal.discount}</span
          >
        </div>

        {
          deal.cashback && (
            <p class="text-xs font-bold text-error mt-1">{deal.cashback}</p>
          )
        }

        <p class="text-xs text-base-content/70 mt-2 line-clamp-2">
          {deal.description}
        </p>
      </div>

      <!-- Button -->
      <div class="w-full md:w-auto shrink-0 flex justify-end">
        <a
          href={detailPageUrl}
          class="btn btn-warning btn-lg font-black tracking-wide w-full md:w-48 shadow"
        >
          VIEW DEAL &rarr;
        </a>
      </div>
    </div>
  </div>
</div>
