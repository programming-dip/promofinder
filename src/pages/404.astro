---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const siteUrl = "https://promofinder.com.au/404.html";
const pageTitle = "404 - Deal Not Found | PromoFinder Australia";
const pageDescription = "Sorry, the page or discount deal you are looking for doesn't exist or has expired.";
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  </head>
  <body class="bg-base-200/30 text-base-content min-h-screen flex flex-col justify-between">
    
    <Header />

    <main class="flex-grow flex items-center justify-center px-4 py-16">
      <div class="max-w-md w-full text-center bg-base-100 p-8 md:p-10 rounded-2xl border border-base-300 shadow-sm">
        
        <!-- Error Badge -->
        <span class="inline-block px-3 py-1 rounded-full bg-warning/20 text-warning text-xs font-black uppercase tracking-wider mb-4">
          Error 404
        </span>

        <!-- Heading -->
        <h1 class="text-4xl md:text-5xl font-black text-base-content tracking-tight mb-2">
          Oops!
        </h1>
        <p class="text-base font-semibold text-base-content/80 mb-3">
          Deal Not Found
        </p>

        <!-- Message -->
        <p class="text-xs md:text-sm text-base-content/60 mb-8 leading-relaxed">
          The coupon code or page you are looking for might have expired, been removed, or had its link mistyped.
        </p>

        <!-- Quick Navigation -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a 
            href="/" 
            class="btn btn-warning btn-sm md:btn-md font-black uppercase tracking-wider text-xs shadow-sm hover:shadow transition"
          >
            Browse All Deals
          </a>
          <a 
            href="/contact/" 
            class="btn btn-ghost btn-sm md:btn-md font-bold uppercase tracking-wider text-xs border border-base-300"
          >
            Report Missing Deal
          </a>
        </div>

      </div>
    </main>

    <Footer />

  </body>
</html>