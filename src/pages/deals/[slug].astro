---
import deals from '../../data/deals.json';
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const currentDate = new Intl.DateTimeFormat("en-AU", {
  month: "long",
  year: "numeric",
}).format(new Date());

export async function getStaticPaths() {
  return deals.map((deal) => ({
    params: { slug: deal.slug },
    props: { deal },
  }));
}

const { deal } = Astro.props;
const pageUrl = `https://promofinder.com.au/deals/${deal.slug}/`;

const faqSchema = deal.content?.faqs ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": deal.content.faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
} : null;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Title in Google Search -->
    <title>{deal.content?.heading || deal.title}</title>

    <!-- Small Description in Google Search-->
    <meta name="description" content={deal.description} />

    <!-- Canonical URL in Google Search -->
    <link rel="canonical" href={pageUrl} />

    <meta property="og:title" content={deal.content?.heading || deal.title} />
    <meta property="og:description" content={deal.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={deal.image} />

    <!-- Google Search logos -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />

    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="bg-base-200/30 text-base-content min-h-screen">
    
    <Header></Header>

    <main class="max-w-3xl mx-auto px-4 py-10">
      <div class="text-xs breadcrumbs mb-6">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/">Deals</a></li>
          <li>{deal.brand}</li>
        </ul>
      </div>

      <article class="bg-base-100 p-8 rounded-2xl border border-base-300 shadow-sm">
        
        <header class="mb-8 border-b border-base-200 pb-8">
          <div class="flex items-center gap-4 mb-4">
            <img src={deal.image} alt={deal.brand} class="w-16 h-16 object-contain rounded-lg border border-base-200 p-2" />
            <div>
              <span class="badge badge-warning font-bold text-xs uppercase">{deal.discount}</span>
              <p class="text-xs text-base-content/60 mt-1">Verified & Active for {currentDate}</p>
            </div>
          </div>
          <h1 class="text-2xl md:text-3xl font-black text-base-content leading-tight">
            {deal.content?.heading || deal.title}
          </h1>
        </header>

        <!-- CTA Action Banner -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <div>
            {deal.code ? (
              <>
                <p class="text-xs uppercase font-bold text-amber-800 tracking-wider">Verified Promo Code</p>
                <p class="text-2xl font-black text-amber-950 tracking-widest mt-1">{deal.code}</p>
              </>
            ) : (
              <>
                <p class="text-xs uppercase font-bold text-blue-800 tracking-wider">Direct Partner Discount</p>
                <p class="text-base font-bold text-blue-950 mt-1">Click the button to enter</p>
              </>
            )}
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
            {deal.code && (
              <button 
                class="copy-code-btn btn btn-warning btn-md font-bold px-8 shadow w-full sm:w-auto"
                data-code={deal.code}
              >
                Copy Code
              </button>
            )}

            {deal.affiliateUrl && (
              <a 
                href={deal.affiliateUrl}
                target="_blank"
                rel="noopener noreferrer nofollow sponsored"
                class="btn btn-primary btn-md font-bold px-8 shadow w-full sm:w-auto"
              >
                Claim Deal & Open Site &rarr;
              </a>
            )}
          </div>
        </div>

        <section class="prose prose-stone max-w-none text-base-content/80 text-sm md:text-base leading-relaxed">
          <p class="text-base leading-relaxed mb-6 font-medium text-base-content">
            {deal.content?.intro || deal.description}
          </p>

          {deal.content?.benefits && (
            <div>
              <h2 class="text-xl font-bold text-base-content mt-8 mb-4">
                Why Use This {deal.brand} Deal?
              </h2>
              <ul class="list-disc pl-5 space-y-2 mb-6">
                {deal.content.benefits.map((benefit) => (
                  <li>{benefit}</li>
                ))}
              </ul>
            </div>
          )}

          {deal.content?.steps && (
            <div>
              <h2 class="text-xl font-bold text-base-content mt-8 mb-4">
                How to Claim This Offer
              </h2>
              <ol class="list-decimal pl-5 space-y-2 mb-6">
                {deal.content.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>

              <!-- App Store Download Badges (Shown only if appLinks exists) -->
              {deal.appLinks && (
                <div class="my-6 p-4 bg-base-200/50 rounded-xl border border-base-300 not-prose">
                  <p class="text-xs font-bold text-base-content/70 uppercase tracking-wider mb-3">
                    Download {deal.brand} Official App:
                  </p>
                  <div class="flex flex-wrap gap-3">
                    {deal.appLinks.ios && (
                      <a 
                        href={deal.appLinks.ios} 
                        target="_blank" 
                        rel="noopener noreferrer nofollow" 
                        class="btn btn-neutral btn-sm md:btn-md gap-2 shadow-sm"
                      >
                        <!-- Apple Icon -->
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 170 170">
                          <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.6-7.79-11.72-14.25-5.77-9.01-10.22-19.16-13.34-30.44-3.13-11.29-4.7-22.14-4.7-32.57 0-14.46 3.63-26.65 10.89-36.57 7.26-9.92 16.48-14.98 27.67-15.19 4.9 0 10.28 1.34 16.14 4.01 5.86 2.68 9.53 4.07 11.02 4.17 1.25-.09 5.27-1.57 12.06-4.44 6.78-2.87 12.33-4.07 16.64-3.6 12.36 1.13 22.38 6.13 30.07 15.01-10.89 6.53-16.19 15.55-15.89 27.06.33 9.01 3.86 16.71 10.58 23.08 6.72 6.37 14.65 10.02 23.78 10.96-2.18 6.64-4.8 13.53-7.87 20.67zM119.22 31.84c0-7.27 2.66-14.15 7.99-20.64 5.33-6.49 12-10.74 20.02-12.76.12 1.48.18 2.76.18 3.83 0 7.37-2.73 14.34-8.19 20.91-5.46 6.57-12.23 10.59-20.31 12.06-.24-1.12-.36-2.26-.36-3.4z"/>
                        </svg>
                        App Store (iOS)
                      </a>
                    )}

                    {deal.appLinks.android && (
                      <a 
                        href={deal.appLinks.android} 
                        target="_blank" 
                        rel="noopener noreferrer nofollow" 
                        class="btn btn-neutral btn-sm md:btn-md gap-2 shadow-sm"
                      >
                        <!-- Google Play Icon -->
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">
                          <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/>
                        </svg>
                        Google Play (Android)
                      </a>
                    )}
                  </div>
                </div>
              )}
            </div>
          )}

          {deal.content?.faqs && (
            <div>
              <h2 class="text-xl font-bold text-base-content mt-10 mb-4">Frequently Asked Questions (FAQ)</h2>
              <div class="space-y-4">
                {deal.content.faqs.map((faq) => (
                  <div class="collapse collapse-arrow bg-base-200/50 border border-base-200 rounded-lg">
                    <input type="checkbox" checked /> 
                    <div class="collapse-title text-base font-bold text-base-content">
                      {faq.q}
                    </div>
                    <div class="collapse-content text-sm text-base-content/70">
                      <p>{faq.a}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>
      </article>
    </main>

    <script>
      document.querySelectorAll('.copy-code-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget;
          const code = target.getAttribute('data-code') || '';
          navigator.clipboard.writeText(code);
          target.textContent = 'Copied!';
          target.classList.replace('btn-warning', 'btn-success');
          target.classList.add('text-white');
          setTimeout(() => {
            target.textContent = 'Copy Code';
            target.classList.replace('btn-success', 'btn-warning');
            target.classList.remove('text-white');
          }, 2500);
        });
      });
    </script>

    <Footer />
  </body>
</html>